{
  "compilerOptions": {
    "module": "commonjs",
    "baseUrl": "./src",
    "paths": {
      "@/utils/*": ["utils/*"],
      "@/middlewares/*": ["middlewares/*"],
      "@/resources/*": ["resources/*"],
      "@/configs/*": ["configs/*"]
    },
    "esModuleInterop": true,
    "target": "es6",
    "moduleResolution": "node",
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "rootDir": "./",
    "outDir": "./dist"
  },
  "include": [
    "src/",
    "package.json",
    "package-lock.json",
    "dump/mode.index.ts"
  ],
  "exclude": ["node_modules", ".build", "dist"],
  "execMap": {
    "ts": "ts-node"
  },
  "lib": ["es2015"]
}
